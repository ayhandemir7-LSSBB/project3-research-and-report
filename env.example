# ---------- Gradio app (.env) ----------

# Base URL of the n8n webhooks the app calls (/form, /chat, /status, /feedback)
N8N_WEBHOOK_URL=

# Shared secret sent in the X-Webhook-Secret header; must match the n8n Header Auth credential
WEBHOOK_SECRET=


# ---------- n8n credentials (set in n8n > Credentials, NOT in this file) ----------
# 1. OpenAI            - API key: gpt-4o-mini (agent, reports, judge) + text-embedding-3-small
# 2. Pinecone          - API key: index fix-my-process-kb (4 namespaces)
# 3. Cohere            - API key: rerank-v3.5 (reranker + Rerank Score)
# 4. Tavily            - API key: web search
# 5. GNews             - Query Auth, parameter "apikey": news search
# 6. OpenAlex          - Query Auth: research papers search
# 7. Airtable          - Personal access token: Submissions + Errors tables
# 8. Slack             - Bot token: #ai-governance-review, #fix-my-process-alerts
# 9. Notion            - Integration token: "Fix My Process: Use Cases" page
# 10. Header Auth       - "FMP webhook secret", header X-Webhook-Secret = same value as WEBHOOK_SECRET
