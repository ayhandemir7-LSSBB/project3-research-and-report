    {
      "parameters": {
        "jsCode": "// Collect the error details from the Error Trigger (one item)\nconst event = $input.first().json || {};\nconst execution = event.execution || {};\nconst workflow = event.workflow || {};\nconst id = String(execution.id || '');\n\n// Keep the message short: error texts can quote parts of the request\nconst message = String((execution.error && execution.error.message) || 'No error message').slice(0, 300);\n\nreturn [{ json: {\n  created_at: new Date().toISOString(),\n  workflow: String(workflow.name || 'Unknown workflow'),\n  execution_id: id,\n  reference_code: id ? 'FMP-' + id : '',\n  node: String(execution.lastNodeExecuted || 'Unknown node'),\n  error_message: message,\n  execution_url: String(execution.url || ''),\n} }];"
      },
